import { NextRequest, NextResponse } from 'next/server';
import { getServerSession } from 'next-auth';
import { authOptions } from '@/lib/auth';

// GET - Get current settings
export async function GET(request: NextRequest) {
  try {
    const session = await getServerSession(authOptions);

    // Check authentication
    if (!session) {
      return NextResponse.json(
        { error: 'Unauthorized' },
        { status: 401 }
      );
    }

    // Check admin role
    if (session.user.role !== 'ADMIN') {
      return NextResponse.json(
        { error: 'Forbidden - Admin access required' },
        { status: 403 }
      );
    }

    // In production, these would come from a database or config service
    // For now, return default settings
    const settings = {
      siteName: '{{projectName}}',
      supportEmail: process.env.SUPPORT_EMAIL || 'support@{{projectName}}.com',
      maxUsers: parseInt(process.env.MAX_USERS || '10000'),
      maintenanceMode: process.env.MAINTENANCE_MODE === 'true',
      allowSignups: process.env.ALLOW_SIGNUPS !== 'false',
      requireEmailVerification: process.env.REQUIRE_EMAIL_VERIFICATION !== 'false',
      sessionTimeout: parseInt(process.env.SESSION_TIMEOUT_DAYS || '7'),
      stripeWebhookSecret: '••••••••', // Masked
      emailProvider: process.env.EMAIL_PROVIDER || 'resend',
    };

    return NextResponse.json({ settings });
  } catch (error) {
    console.error('Error fetching settings:', error);
    return NextResponse.json(
      { error: 'Internal server error' },
      { status: 500 }
    );
  }
}

// POST - Update settings
export async function POST(request: NextRequest) {
  try {
    const session = await getServerSession(authOptions);

    // Check authentication
    if (!session) {
      return NextResponse.json(
        { error: 'Unauthorized' },
        { status: 401 }
      );
    }

    // Check admin role
    if (session.user.role !== 'ADMIN') {
      return NextResponse.json(
        { error: 'Forbidden - Admin access required' },
        { status: 403 }
      );
    }

    const settings = await request.json();

    // Validate settings
    if (settings.maxUsers < 1) {
      return NextResponse.json(
        { error: 'Maximum users must be at least 1' },
        { status: 400 }
      );
    }

    if (settings.sessionTimeout < 1 || settings.sessionTimeout > 30) {
      return NextResponse.json(
        { error: 'Session timeout must be between 1 and 30 days' },
        { status: 400 }
      );
    }

    // In production, save to database or config service
    // For now, you might want to update environment variables or a settings table

    // Example: Save to database
    // await prisma.settings.upsert({
    //   where: { id: 'global' },
    //   update: settings,
    //   create: { id: 'global', ...settings },
    // });

    // Log the settings change
    console.log(`Settings updated by ${session.user.email}:`, settings);

    return NextResponse.json({
      message: 'Settings updated successfully',
      settings,
    });
  } catch (error) {
    console.error('Error updating settings:', error);
    return NextResponse.json(
      { error: 'Internal server error' },
      { status: 500 }
    );
  }
}
