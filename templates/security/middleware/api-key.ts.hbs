import { Request, Response, NextFunction } from 'express';
import crypto from 'crypto';
import { Redis } from 'ioredis';

// API key configuration interface
export interface ApiKeyConfig {
  headerName?: string;
  queryParamName?: string;
  redis?: Redis;
  cacheTTL?: number; // Time to cache API keys in memory
  allowQueryParam?: boolean; // Whether to allow API key in query params (less secure)
  customValidator?: (apiKey: string, req: Request) => Promise<ApiKeyData | null>;
}

// API key data interface
export interface ApiKeyData {
  id: string;
  key: string;
  userId?: string;
  name?: string;
  scopes?: string[];
  rateLimit?: {
    maxRequests: number;
    windowMs: number;
  };
  expiresAt?: Date;
  lastUsedAt?: Date;
  createdAt: Date;
  isActive: boolean;
}

// Default configuration
const defaultConfig: Required<Omit<ApiKeyConfig, 'redis' | 'customValidator'>> = {
  headerName: 'x-api-key',
  queryParamName: 'api_key',
  cacheTTL: 5 * 60 * 1000, // 5 minutes
  allowQueryParam: false,
};

// In-memory cache for API keys
interface CachedApiKey {
  data: ApiKeyData;
  cachedAt: number;
}

const apiKeyCache = new Map<string, CachedApiKey>();

// Clean up expired cache entries every 10 minutes
setInterval(() => {
  const now = Date.now();
  for (const [key, value] of apiKeyCache.entries()) {
    if (now - value.cachedAt > defaultConfig.cacheTTL) {
      apiKeyCache.delete(key);
    }
  }
}, 10 * 60 * 1000);

/**
 * Generate a secure API key
 * Format: prefix_randomstring
 */
export function generateApiKey(prefix: string = 'sk'): string {
  const randomPart = crypto.randomBytes(32).toString('base64url');
  return `${prefix}_${randomPart}`;
}

/**
 * Hash API key for secure storage
 */
export function hashApiKey(apiKey: string): string {
  return crypto.createHash('sha256').update(apiKey).digest('hex');
}

/**
 * Get API key from request
 */
function getApiKeyFromRequest(req: Request, config: ApiKeyConfig): string | null {
  const options = { ...defaultConfig, ...config };

  // Try to get from header (preferred)
  const headerKey = req.headers[options.headerName.toLowerCase()] as string;
  if (headerKey) {
    // Support "Bearer token" format
    if (headerKey.startsWith('Bearer ')) {
      return headerKey.slice(7);
    }
    return headerKey;
  }

  // Try to get from query param (if allowed)
  if (options.allowQueryParam) {
    const queryKey = req.query[options.queryParamName] as string;
    if (queryKey) {
      return queryKey;
    }
  }

  return null;
}

/**
 * Validate API key format
 */
function isValidApiKeyFormat(apiKey: string): boolean {
  // Check if key follows the format: prefix_base64url
  const pattern = /^[a-z]{2,4}_[A-Za-z0-9_-]{40,}$/;
  return pattern.test(apiKey);
}

/**
 * Get API key data from cache
 */
function getCachedApiKey(apiKey: string, cacheTTL: number): ApiKeyData | null {
  const cached = apiKeyCache.get(apiKey);
  if (!cached) return null;

  const now = Date.now();
  if (now - cached.cachedAt > cacheTTL) {
    apiKeyCache.delete(apiKey);
    return null;
  }

  return cached.data;
}

/**
 * Cache API key data
 */
function cacheApiKey(apiKey: string, data: ApiKeyData): void {
  apiKeyCache.set(apiKey, {
    data,
    cachedAt: Date.now(),
  });
}

