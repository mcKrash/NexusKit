import { Request, Response, NextFunction } from 'express';
import { Redis } from 'ioredis';

// Rate limiter configuration
interface RateLimitConfig {
  windowMs: number; // Time window in milliseconds
  maxRequests: number; // Maximum requests per window
  message?: string;
  skipSuccessfulRequests?: boolean;
  skipFailedRequests?: boolean;
}

// Predefined rate limit configurations
export const rateLimitConfigs = {
  auth: {
    windowMs: 15 * 60 * 1000, // 15 minutes
    maxRequests: 5,
    message: 'Too many authentication attempts. Please try again later.',
  },
  api: {
    windowMs: 60 * 60 * 1000, // 1 hour
    maxRequests: 100,
    message: 'API rate limit exceeded. Please try again later.',
  },
  strict: {
    windowMs: 15 * 60 * 1000, // 15 minutes
    maxRequests: 10,
    message: 'Too many requests. Please slow down.',
  },
  standard: {
    windowMs: 15 * 60 * 1000, // 15 minutes
    maxRequests: 100,
    message: 'Rate limit exceeded. Please try again later.',
  },
} as const;

// Redis client for distributed rate limiting (optional)
let redisClient: Redis | null = null;

/**
 * Initialize Redis client for distributed rate limiting
 * @param redisUrl - Redis connection URL
 */
export function initializeRedis(redisUrl?: string): void {
  if (!redisUrl) return;

  try {
    redisClient = new Redis(redisUrl, {
      retryStrategy: (times) => {
        const delay = Math.min(times * 50, 2000);
        return delay;
      },
      maxRetriesPerRequest: 3,
    });

    redisClient.on('error', (err) => {
      console.error('Redis connection error:', err);
      // Fallback to in-memory store on Redis failure
      redisClient = null;
    });

    redisClient.on('connect', () => {
      console.log('Redis connected for rate limiting');
    });
  } catch (error) {
    console.error('Failed to initialize Redis:', error);
    redisClient = null;
  }
}

// In-memory store for rate limiting (fallback)
interface RateLimitRecord {
  count: number;
  resetTime: number;
}

const inMemoryStore = new Map<string, RateLimitRecord>();

// Clean up expired entries every 5 minutes
setInterval(() => {
  const now = Date.now();
  for (const [key, record] of inMemoryStore.entries()) {
    if (record.resetTime < now) {
      inMemoryStore.delete(key);
    }
  }
}, 5 * 60 * 1000);

/**
 * Get client identifier from request
 * @param req - Express request object
 * @returns Client identifier string
 */
function getClientIdentifier(req: Request): string {
  // Try to get IP from various headers (for proxy support)
  const forwarded = req.headers['x-forwarded-for'];
  const realIp = req.headers['x-real-ip'];
  const cfConnectingIp = req.headers['cf-connecting-ip'];

  let ip: string;

  if (typeof forwarded === 'string') {
    ip = forwarded.split(',')[0].trim();
  } else if (typeof realIp === 'string') {
    ip = realIp;
  } else if (typeof cfConnectingIp === 'string') {
    ip = cfConnectingIp;
  } else {
    ip = req.ip || req.socket.remoteAddress || 'unknown';
  }

  // Optionally include user ID for authenticated requests
  const userId = (req as any).user?.id;
  return userId ? `user:${userId}` : `ip:${ip}`;
}

/**
 * Get rate limit data from Redis
 */
async function getRedisRateLimit(
  key: string,
  windowMs: number
): Promise<{ count: number; ttl: number }> {
  if (!redisClient) {
    throw new Error('Redis client not initialized');
  }

  const now = Date.now();
  const windowStart = now - windowMs;

  try {
    // Use Redis sorted set to track requests with timestamps
    const multi = redisClient.multi();

    // Remove old entries
    multi.zremrangebyscore(key, 0, windowStart);

    // Add current request
    multi.zadd(key, now, `${now}-${Math.random()}`);

    // Count requests in window
    multi.zcard(key);

    // Set expiration
    multi.expire(key, Math.ceil(windowMs / 1000));

    const results = await multi.exec();

    if (!results) {
      throw new Error('Redis transaction failed');
    }

    const count = results[2][1] as number;
    const ttl = await redisClient.pttl(key);

    return { count, ttl: ttl > 0 ? ttl : windowMs };
  } catch (error) {
    console.error('Redis rate limit error:', error);
    throw error;
  }
}

/**
 * Get rate limit data from in-memory store
 */
function getMemoryRateLimit(
  key: string,
  windowMs: number
): { count: number; ttl: number } {
  const now = Date.now();
  const record = inMemoryStore.get(key);

  if (!record || record.resetTime < now) {
    const newRecord: RateLimitRecord = {
      count: 1,
      resetTime: now + windowMs,
    };
    inMemoryStore.set(key, newRecord);
    return { count: 1, ttl: windowMs };
  }

  record.count++;
  return { count: record.count, ttl: record.resetTime - now };
}

/**
 * Rate limiting middleware factory
 * @param config - Rate limit configuration
 * @returns Express middleware function
 */
export function rateLimit(config: RateLimitConfig) {
  const {
    windowMs,
    maxRequests,
    message = 'Too many requests, please try again later.',
    skipSuccessfulRequests = false,
    skipFailedRequests = false,
  } = config;

  return async (req: Request, res: Response, next: NextFunction) => {
    try {
      const identifier = getClientIdentifier(req);
      const key = `ratelimit:${identifier}:${req.path}`;

      let count: number;
      let ttl: number;

      try {
        // Try Redis first
        if (redisClient) {
          const result = await getRedisRateLimit(key, windowMs);
          count = result.count;
          ttl = result.ttl;
        } else {
          // Fallback to in-memory store
          const result = getMemoryRateLimit(key, windowMs);
          count = result.count;
          ttl = result.ttl;
        }
      } catch (error) {
        console.error('Rate limit check error:', error);
        // On error, allow the request but log the issue
        return next();
      }

      // Set rate limit headers
      res.setHeader('X-RateLimit-Limit', maxRequests.toString());
      res.setHeader('X-RateLimit-Remaining', Math.max(0, maxRequests - count).toString());
      res.setHeader('X-RateLimit-Reset', new Date(Date.now() + ttl).toISOString());

      // Check if rate limit exceeded
      if (count > maxRequests) {
        res.setHeader('Retry-After', Math.ceil(ttl / 1000).toString());

        return res.status(429).json({
          error: 'Too Many Requests',
          message,
          retryAfter: Math.ceil(ttl / 1000),
        });
      }

      // Handle skip options
      if (skipSuccessfulRequests || skipFailedRequests) {
        const originalSend = res.send;
        res.send = function (data) {
          const statusCode = res.statusCode;
          const shouldSkip =
            (skipSuccessfulRequests && statusCode < 400) ||
            (skipFailedRequests && statusCode >= 400);

          if (shouldSkip && redisClient) {
            // Decrement counter
            redisClient
              .zincrby(key, -1, `${Date.now()}-${Math.random()}`)
              .catch(console.error);
          } else if (shouldSkip) {
            const record = inMemoryStore.get(key);
            if (record) {
              record.count = Math.max(0, record.count - 1);
            }
          }

          return originalSend.call(this, data);
        };
      }

      next();
    } catch (error) {
      console.error('Rate limit middleware error:', error);
      // On error, allow the request
      next();
    }
  };
}

/**
 * Create rate limiter with predefined configuration
 * @param type - Rate limit type (auth, api, strict, standard)
 * @returns Express middleware function
 */
export function createRateLimiter(type: keyof typeof rateLimitConfigs) {
  return rateLimit(rateLimitConfigs[type]);
}

/**
 * Dynamic rate limiter that adjusts based on user tier
 */
export function dynamicRateLimit(baseConfig: RateLimitConfig) {
  return async (req: Request, res: Response, next: NextFunction) => {
    const user = (req as any).user;

    // Adjust limits based on user tier
    let multiplier = 1;
    if (user?.tier === 'premium') {
      multiplier = 5;
    } else if (user?.tier === 'pro') {
      multiplier = 3;
    } else if (user?.tier === 'basic') {
      multiplier = 1.5;
    }

    const config = {
      ...baseConfig,
      maxRequests: Math.floor(baseConfig.maxRequests * multiplier),
    };

    return rateLimit(config)(req, res, next);
  };
}

export default rateLimit;
