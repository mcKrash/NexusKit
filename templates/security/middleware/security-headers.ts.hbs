import { Request, Response, NextFunction } from 'express';

// Security headers configuration interface
export interface SecurityHeadersConfig {
  // Strict-Transport-Security
  hsts?: {
    enabled?: boolean;
    maxAge?: number;
    includeSubDomains?: boolean;
    preload?: boolean;
  };

  // Content-Security-Policy
  csp?: {
    enabled?: boolean;
    directives?: Record<string, string | string[]>;
    reportOnly?: boolean;
    reportUri?: string;
  };

  // X-Frame-Options
  frameOptions?: 'DENY' | 'SAMEORIGIN' | string | false;

  // X-Content-Type-Options
  noSniff?: boolean;

  // X-XSS-Protection
  xssProtection?: boolean | string;

  // Referrer-Policy
  referrerPolicy?: string;

  // Permissions-Policy
  permissionsPolicy?: Record<string, string[]>;

  // Cross-Origin policies
  crossOriginEmbedderPolicy?: boolean | string;
  crossOriginOpenerPolicy?: boolean | string;
  crossOriginResourcePolicy?: boolean | string;
}

// Default security headers configuration
const defaultConfig: SecurityHeadersConfig = {
  hsts: {
    enabled: true,
    maxAge: 31536000, // 1 year
    includeSubDomains: true,
    preload: true,
  },
  csp: {
    enabled: true,
    directives: {
      'default-src': ["'self'"],
      'script-src': ["'self'", "'unsafe-inline'"],
      'style-src': ["'self'", "'unsafe-inline'"],
      'img-src': ["'self'", 'data:', 'https:'],
      'font-src': ["'self'", 'data:'],
      'connect-src': ["'self'"],
      'frame-ancestors': ["'none'"],
      'base-uri': ["'self'"],
      'form-action': ["'self'"],
    },
    reportOnly: false,
  },
  frameOptions: 'DENY',
  noSniff: true,
  xssProtection: true,
  referrerPolicy: 'strict-origin-when-cross-origin',
  permissionsPolicy: {
    camera: [],
    microphone: [],
    geolocation: [],
    'payment': [],
  },
  crossOriginEmbedderPolicy: 'require-corp',
  crossOriginOpenerPolicy: 'same-origin',
  crossOriginResourcePolicy: 'same-origin',
};

/**
 * Build Content-Security-Policy header value
 */
function buildCSPHeader(directives: Record<string, string | string[]>): string {
  return Object.entries(directives)
    .map(([key, value]) => {
      const values = Array.isArray(value) ? value : [value];
      return `${key} ${values.join(' ')}`;
    })
    .join('; ');
}

/**
 * Build Permissions-Policy header value
 */
function buildPermissionsPolicyHeader(policies: Record<string, string[]>): string {
  return Object.entries(policies)
    .map(([key, origins]) => {
      if (origins.length === 0) {
        return `${key}=()`;
      }
      return `${key}=(${origins.join(' ')})`;
    })
    .join(', ');
}

/**
 * Security headers middleware factory
 * @param config - Security headers configuration
 * @returns Express middleware function
 */
export function securityHeaders(config: SecurityHeadersConfig = {}) {
  const options = { ...defaultConfig, ...config };

  return (req: Request, res: Response, next: NextFunction) => {
    try {
      // Strict-Transport-Security (HSTS)
      if (options.hsts?.enabled && req.secure) {
        let hstsValue = `max-age=${options.hsts.maxAge}`;
        if (options.hsts.includeSubDomains) {
          hstsValue += '; includeSubDomains';
        }
        if (options.hsts.preload) {
          hstsValue += '; preload';
        }
        res.setHeader('Strict-Transport-Security', hstsValue);
      }

      // Content-Security-Policy
      if (options.csp?.enabled && options.csp.directives) {
        const cspValue = buildCSPHeader(options.csp.directives);
        const headerName = options.csp.reportOnly
          ? 'Content-Security-Policy-Report-Only'
          : 'Content-Security-Policy';

        res.setHeader(headerName, cspValue);

        // Add report-uri if specified
        if (options.csp.reportUri) {
          res.setHeader('Report-To', JSON.stringify({
            group: 'csp-endpoint',
            max_age: 31536000,
            endpoints: [{ url: options.csp.reportUri }],
          }));
        }
      }

      // X-Frame-Options
      if (options.frameOptions) {
        res.setHeader('X-Frame-Options', options.frameOptions);
      }

      // X-Content-Type-Options
      if (options.noSniff) {
        res.setHeader('X-Content-Type-Options', 'nosniff');
      }

      // X-XSS-Protection (legacy, but still useful for older browsers)
      if (options.xssProtection) {
        const value = typeof options.xssProtection === 'string'
          ? options.xssProtection
          : '1; mode=block';
        res.setHeader('X-XSS-Protection', value);
      }

      // Referrer-Policy
      if (options.referrerPolicy) {
        res.setHeader('Referrer-Policy', options.referrerPolicy);
      }

      // Permissions-Policy
      if (options.permissionsPolicy) {
        const value = buildPermissionsPolicyHeader(options.permissionsPolicy);
        res.setHeader('Permissions-Policy', value);
      }

      // Cross-Origin-Embedder-Policy
      if (options.crossOriginEmbedderPolicy) {
        const value = typeof options.crossOriginEmbedderPolicy === 'string'
          ? options.crossOriginEmbedderPolicy
          : 'require-corp';
        res.setHeader('Cross-Origin-Embedder-Policy', value);
      }

      // Cross-Origin-Opener-Policy
      if (options.crossOriginOpenerPolicy) {
        const value = typeof options.crossOriginOpenerPolicy === 'string'
          ? options.crossOriginOpenerPolicy
          : 'same-origin';
        res.setHeader('Cross-Origin-Opener-Policy', value);
      }

      // Cross-Origin-Resource-Policy
      if (options.crossOriginResourcePolicy) {
        const value = typeof options.crossOriginResourcePolicy === 'string'
          ? options.crossOriginResourcePolicy
          : 'same-origin';
        res.setHeader('Cross-Origin-Resource-Policy', value);
      }

      // Remove sensitive headers
      res.removeHeader('X-Powered-By');
      res.removeHeader('Server');

      next();
    } catch (error) {
      console.error('Security headers middleware error:', error);
      // Continue even if there's an error
      next();
    }
  };
}

/**
 * Strict security headers for production
 */
export function strictSecurityHeaders() {
  return securityHeaders({
    hsts: {
      enabled: true,
      maxAge: 63072000, // 2 years
      includeSubDomains: true,
      preload: true,
    },
    csp: {
      enabled: true,
      directives: {
        'default-src': ["'none'"],
        'script-src': ["'self'"],
        'style-src': ["'self'"],
        'img-src': ["'self'", 'data:', 'https:'],
        'font-src': ["'self'"],
        'connect-src': ["'self'"],
        'frame-ancestors': ["'none'"],
        'base-uri': ["'self'"],
        'form-action': ["'self'"],
        'upgrade-insecure-requests': [],
      },
    },
    frameOptions: 'DENY',
    noSniff: true,
    xssProtection: '1; mode=block',
    referrerPolicy: 'no-referrer',
    permissionsPolicy: {
      camera: [],
      microphone: [],
      geolocation: [],
      payment: [],
      usb: [],
      'screen-wake-lock': [],
    },
  });
}

/**
 * Development security headers (more permissive)
 */
export function devSecurityHeaders() {
  return securityHeaders({
    hsts: {
      enabled: false,
    },
    csp: {
      enabled: true,
      directives: {
        'default-src': ["'self'"],
        'script-src': ["'self'", "'unsafe-inline'", "'unsafe-eval'"],
        'style-src': ["'self'", "'unsafe-inline'"],
        'img-src': ["'self'", 'data:', 'https:', 'http:'],
        'font-src': ["'self'", 'data:'],
        'connect-src': ["'self'", 'ws:', 'wss:'],
      },
      reportOnly: true,
    },
    frameOptions: 'SAMEORIGIN',
    noSniff: true,
    xssProtection: true,
  });
}

/**
 * API-specific security headers
 */
export function apiSecurityHeaders() {
  return securityHeaders({
    hsts: {
      enabled: true,
      maxAge: 31536000,
      includeSubDomains: true,
    },
    csp: {
      enabled: true,
      directives: {
        'default-src': ["'none'"],
        'frame-ancestors': ["'none'"],
      },
    },
    frameOptions: 'DENY',
    noSniff: true,
    referrerPolicy: 'no-referrer',
    crossOriginResourcePolicy: 'same-site',
  });
}

/**
 * Custom CSP directives for different page types
 */
export const cspDirectives = {
  // For pages with inline scripts (use nonces in production)
  inlineScripts: {
    'script-src': ["'self'", "'unsafe-inline'"],
  },

  // For pages using CDN resources
  cdnResources: {
    'script-src': ["'self'", 'https://cdn.jsdelivr.net', 'https://unpkg.com'],
    'style-src': ["'self'", 'https://fonts.googleapis.com'],
    'font-src': ["'self'", 'https://fonts.gstatic.com'],
  },

  // For pages with payment forms
  payment: {
    'script-src': ["'self'", 'https://js.stripe.com'],
    'frame-src': ["'self'", 'https://js.stripe.com'],
    'connect-src': ["'self'", 'https://api.stripe.com'],
  },

  // For pages with analytics
  analytics: {
    'script-src': ["'self'", 'https://www.google-analytics.com', 'https://www.googletagmanager.com'],
    'img-src': ["'self'", 'data:', 'https:', 'https://www.google-analytics.com'],
    'connect-src': ["'self'", 'https://www.google-analytics.com'],
  },

  // For pages with video embeds
  videoEmbeds: {
    'frame-src': ["'self'", 'https://www.youtube.com', 'https://player.vimeo.com'],
  },

  // For pages with maps
  maps: {
    'script-src': ["'self'", 'https://maps.googleapis.com'],
