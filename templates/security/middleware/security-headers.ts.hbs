    'img-src': ["'self'", 'data:', 'https:', 'https://maps.googleapis.com', 'https://maps.gstatic.com'],
  },
};

/**
 * Merge CSP directives
 */
export function mergeCSPDirectives(
  ...directiveSets: Array<Record<string, string | string[]>>
): Record<string, string[]> {
  const merged: Record<string, string[]> = {};

  for (const directives of directiveSets) {
    for (const [key, value] of Object.entries(directives)) {
      const values = Array.isArray(value) ? value : [value];
      if (!merged[key]) {
        merged[key] = [];
      }
      merged[key].push(...values);
    }
  }

  // Remove duplicates
  for (const key in merged) {
    merged[key] = [...new Set(merged[key])];
  }

  return merged;
}

/**
 * Apply security headers based on environment
 */
export function environmentSecurityHeaders() {
  const env = process.env.NODE_ENV;

  if (env === 'production') {
    return strictSecurityHeaders();
  }

  if (env === 'development' || env === 'test') {
    return devSecurityHeaders();
  }

  return securityHeaders();
}

export default securityHeaders;
