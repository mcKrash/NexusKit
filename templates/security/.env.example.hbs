# Environment
NODE_ENV=development

# Server
PORT=3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/{{projectName}}

# Redis (Optional - for distributed rate limiting and CSRF)
REDIS_URL=redis://localhost:6379
ENABLE_REDIS=false

# Session
SESSION_SECRET=change-this-to-a-random-secret-key-in-production

# JWT (if using JWT authentication)
JWT_SECRET=change-this-to-a-random-jwt-secret-in-production
JWT_ISSUER={{projectName}}
JWT_AUDIENCE={{projectName}}-users

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Security Headers
CSP_REPORT_URI=

# Email
EMAIL_FROM=noreply@{{projectName}}.com
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# API Keys (if using)
API_KEY_HEADER=x-api-key

# File Upload
MAX_FILE_SIZE=5242880

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Monitoring
ENABLE_API_DOCS=true
SENTRY_DSN=

# Stripe (if using)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# OAuth (if using)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Feature Flags
ENABLE_WEBHOOKS=true
ENABLE_API_KEYS=true
ENABLE_EMAIL_VERIFICATION=true
