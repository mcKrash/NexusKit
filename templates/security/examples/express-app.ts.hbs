/**
 * Example Express Application with Security
 * This demonstrates how to use all security features together
 */

import express, { Request, Response, NextFunction } from 'express';
import cookieParser from 'cookie-parser';
import session from 'express-session';
import Redis from 'ioredis';
import RedisStore from 'connect-redis';

// Import security modules
import {
  initializeSecurity,
  productionSecurity,
  devSecurity,
  createRateLimiter,
  validateData,
  signUpSchema,
  signInSchema,
  passwordSchema,
  sanitizeHtml,
  apiKeyAuth,
  requireScope,
  securityConfig,
} from '../index';

// Initialize Express
const app = express();
const PORT = process.env.PORT || 3000;
const isDev = process.env.NODE_ENV === 'development';

// ============================================================================
// Basic Middleware
// ============================================================================

app.use(express.json());
app.use(express.urlencoded({ extended: true }));
app.use(cookieParser());

// ============================================================================
// Session Configuration (if using sessions)
// ============================================================================

if (process.env.REDIS_URL) {
  const redis = new Redis(process.env.REDIS_URL);

  app.use(
    session({
      store: new RedisStore({ client: redis }),
      secret: securityConfig.session.secret,
      resave: false,
      saveUninitialized: false,
      cookie: securityConfig.session.cookie,
    })
  );
} else {
  app.use(
    session({
      secret: securityConfig.session.secret,
      resave: false,
      saveUninitialized: false,
      cookie: securityConfig.session.cookie,
    })
  );
}

// ============================================================================
// Security Middleware
// ============================================================================

if (isDev) {
  // Development: Relaxed security
  devSecurity(app);
} else {
  // Production: Strict security
  productionSecurity(app, process.env.REDIS_URL);
}

