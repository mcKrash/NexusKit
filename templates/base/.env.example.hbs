# ==================================
# APPLICATION CONFIGURATION
# ==================================

# Application URL (used for callbacks, emails, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node Environment (development, production, test)
NODE_ENV=development

# ==================================
# DATABASE
# ==================================

# PostgreSQL Database URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:password@localhost:5432/{{projectName}}"

# Direct connection URL (for migrations)
DIRECT_URL="postgresql://postgres:password@localhost:5432/{{projectName}}"

# ==================================
# AUTHENTICATION (NextAuth.js)
# ==================================

# NextAuth Secret - Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-key-change-this-in-production"

# NextAuth URL (should match NEXT_PUBLIC_APP_URL)
NEXTAUTH_URL=http://localhost:3000

{{#if features.googleAuth}}
# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
{{/if}}

{{#if features.githubAuth}}
# GitHub OAuth
GITHUB_ID="your-github-client-id"
GITHUB_SECRET="your-github-client-secret"
{{/if}}

{{#if features.emailAuth}}
# Email Authentication
EMAIL_SERVER_HOST="smtp.example.com"
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER="your-email@example.com"
EMAIL_SERVER_PASSWORD="your-email-password"
EMAIL_FROM="noreply@{{projectName}}.com"
{{/if}}

# ==================================
# PAYMENT (Stripe)
# ==================================

{{#if features.stripe}}
# Stripe API Keys
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"

# Stripe Webhook Secret (from Stripe Dashboard)
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"

# Stripe Price IDs for subscription plans
STRIPE_PRICE_ID_BASIC="price_basic_monthly"
STRIPE_PRICE_ID_PRO="price_pro_monthly"
STRIPE_PRICE_ID_ENTERPRISE="price_enterprise_monthly"
{{/if}}

# ==================================
# EMAIL SERVICE
# ==================================

{{#if features.resend}}
# Resend (for transactional emails)
RESEND_API_KEY="re_your_resend_api_key"
{{/if}}

{{#if features.sendgrid}}
# SendGrid
SENDGRID_API_KEY="SG.your_sendgrid_api_key"
{{/if}}

# ==================================
# STORAGE
# ==================================

{{#if features.aws}}
# AWS S3 (for file uploads)
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_REGION="us-east-1"
AWS_S3_BUCKET="your-bucket-name"
{{/if}}

{{#if features.cloudinary}}
# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
{{/if}}

# ==================================
# ANALYTICS
# ==================================

{{#if features.analytics}}
# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# PostHog (optional)
NEXT_PUBLIC_POSTHOG_KEY="phc_your_posthog_key"
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"
{{/if}}

# ==================================
# MONITORING & ERROR TRACKING
# ==================================

{{#if features.sentry}}
# Sentry
SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"
NEXT_PUBLIC_SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"
{{/if}}

# ==================================
# RATE LIMITING & REDIS
# ==================================

{{#if features.redis}}
# Redis (for rate limiting, caching, sessions)
REDIS_URL="redis://localhost:6379"
{{/if}}

# ==================================
# AI/ML SERVICES (Optional)
# ==================================

{{#if features.openai}}
# OpenAI
OPENAI_API_KEY="sk-your-openai-api-key"
{{/if}}

# ==================================
# FEATURE FLAGS
# ==================================

# Enable/disable features
NEXT_PUBLIC_ENABLE_REGISTRATION=true
NEXT_PUBLIC_ENABLE_SOCIAL_LOGIN=true
NEXT_PUBLIC_ENABLE_EMAIL_VERIFICATION=true
NEXT_PUBLIC_ENABLE_WAITLIST=false

# ==================================
# DEVELOPMENT
# ==================================

# Enable debug logs
DEBUG=false

# Skip email verification in development
SKIP_EMAIL_VERIFICATION=true
