{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm install && pnpm build",
    "watchPatterns": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.js",
      "**/*.jsx"
    ]
  },
  "deploy": {
    "startCommand": "pnpm start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "numReplicas": 1,
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 300
  },
  "regions": ["{{region}}"],
  "service": {
    "name": "{{projectName}}",
    "icon": "🚀",
    "type": "web"
  },
  "variables": {
    "NODE_ENV": "production",
    "PORT": "3000",
    "DATABASE_URL": "${{{{raw}}}}{{RAILWAY_DATABASE_URL}}{{{{/raw}}}}",
    {{#if features.redis}}
    "REDIS_URL": "${{{{raw}}}}{{RAILWAY_REDIS_URL}}{{{{/raw}}}}",
    {{/if}}
    "NEXTAUTH_URL": "${{{{raw}}}}{{RAILWAY_PUBLIC_DOMAIN}}{{{{/raw}}}}",
    "NEXTAUTH_SECRET": "${{{{raw}}}}{{NEXTAUTH_SECRET}}{{{{/raw}}}}",
    {{#if auth.github}}
    "GITHUB_ID": "${{{{raw}}}}{{GITHUB_ID}}{{{{/raw}}}}",
    "GITHUB_SECRET": "${{{{raw}}}}{{GITHUB_SECRET}}{{{{/raw}}}}",
    {{/if}}
    {{#if auth.google}}
    "GOOGLE_CLIENT_ID": "${{{{raw}}}}{{GOOGLE_CLIENT_ID}}{{{{/raw}}}}",
    "GOOGLE_CLIENT_SECRET": "${{{{raw}}}}{{GOOGLE_CLIENT_SECRET}}{{{{/raw}}}}",
    {{/if}}
    {{#if payments.stripe}}
    "STRIPE_SECRET_KEY": "${{{{raw}}}}{{STRIPE_SECRET_KEY}}{{{{/raw}}}}",
    "STRIPE_PUBLISHABLE_KEY": "${{{{raw}}}}{{STRIPE_PUBLISHABLE_KEY}}{{{{/raw}}}}",
    "STRIPE_WEBHOOK_SECRET": "${{{{raw}}}}{{STRIPE_WEBHOOK_SECRET}}{{{{/raw}}}}",
    {{/if}}
    {{#if email.resend}}
    "RESEND_API_KEY": "${{{{raw}}}}{{RESEND_API_KEY}}{{{{/raw}}}}",
    {{/if}}
    {{#if email.sendgrid}}
    "SENDGRID_API_KEY": "${{{{raw}}}}{{SENDGRID_API_KEY}}{{{{/raw}}}}",
    {{/if}}
    "NEXT_PUBLIC_APP_URL": "${{{{raw}}}}{{RAILWAY_PUBLIC_DOMAIN}}{{{{/raw}}}}"
  },
  "services": [
    {
      "name": "{{projectName}}-web",
      "type": "web",
      "source": {
        "type": "git",
        "repo": "{{gitRepo}}",
        "branch": "main"
      },
      "build": {
        "buildCommand": "pnpm install && pnpm build"
      },
      "deploy": {
        "startCommand": "pnpm start"
      },
      "healthcheck": {
        "path": "/api/health",
        "interval": 30,
        "timeout": 10,
        "retries": 3
      }
    },
    {{#if database.postgres}}
    {
      "name": "{{projectName}}-postgres",
      "type": "postgres",
      "plan": "starter",
      "version": "15"
    }{{#if features.redis}},{{/if}}
    {{/if}}
    {{#if features.redis}}
    {
      "name": "{{projectName}}-redis",
      "type": "redis",
      "plan": "starter",
      "version": "7"
    }
    {{/if}}
  ],
  "environments": {
    "production": {
      "variables": {
        "NODE_ENV": "production"
      }
    },
    "staging": {
      "variables": {
        "NODE_ENV": "staging"
      }
    }
  }
}
