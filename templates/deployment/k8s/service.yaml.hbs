apiVersion: v1
kind: Service
metadata:
  name: {{projectName}}
  labels:
    app: {{projectName}}
spec:
  type: ClusterIP
  ports:
  - port: 80
    targetPort: http
    protocol: TCP
    name: http
  selector:
    app: {{projectName}}
  sessionAffinity: ClientIP
  sessionAffinityConfig:
    clientIP:
      timeoutSeconds: 10800
