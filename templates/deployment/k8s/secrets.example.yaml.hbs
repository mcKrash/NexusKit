# Example secrets file - DO NOT commit actual secrets to Git
# Create actual secrets using kubectl:
# kubectl create secret generic {{projectName}}-secrets \
#   --from-literal=database-url=<your-database-url> \
#   --from-literal=nextauth-secret=<your-nextauth-secret> \
#   # ... add other secrets

apiVersion: v1
kind: Secret
metadata:
  name: {{projectName}}-secrets
  labels:
    app: {{projectName}}
type: Opaque
stringData:
  # Database
  database-url: "postgresql://user:password@host:5432/database"

  {{#if features.redis}}
  # Redis
  redis-url: "redis://host:6379"
  {{/if}}

  # NextAuth
  nextauth-secret: "your-nextauth-secret-here"

  {{#if auth.github}}
  # GitHub OAuth
  github-id: "your-github-client-id"
  github-secret: "your-github-client-secret"
  {{/if}}

  {{#if auth.google}}
  # Google OAuth
  google-client-id: "your-google-client-id"
  google-client-secret: "your-google-client-secret"
  {{/if}}

  {{#if payments.stripe}}
  # Stripe
  stripe-secret-key: "sk_test_your-stripe-secret-key"
  stripe-webhook-secret: "whsec_your-webhook-secret"
  {{/if}}

  {{#if email.resend}}
  # Resend
  resend-api-key: "re_your-resend-api-key"
  {{/if}}

  {{#if email.sendgrid}}
  # SendGrid
  sendgrid-api-key: "SG.your-sendgrid-api-key"
  {{/if}}
