import { NextResponse } from 'next/server';
{{#if database.prisma}}
import { prisma } from '@/lib/prisma';
{{/if}}
{{#if features.redis}}
import { redis } from '@/lib/redis';
{{/if}}

interface HealthCheck {
  status: 'healthy' | 'degraded' | 'unhealthy';
  timestamp: string;
  uptime: number;
  services: {
    database?: {
      status: 'up' | 'down';
      responseTime?: number;
      error?: string;
    };
    redis?: {
      status: 'up' | 'down';
      responseTime?: number;
      error?: string;
    };
  };
  environment: string;
  version: string;
}

// Cache health check results for 30 seconds to avoid overwhelming services
let cachedHealth: HealthCheck | null = null;
let cacheTimestamp: number = 0;
const CACHE_TTL = 30000; // 30 seconds

async function checkDatabase(): Promise<{
  status: 'up' | 'down';
  responseTime?: number;
  error?: string;
}> {
  {{#if database.prisma}}
  const start = Date.now();
  try {
    // Simple query to check database connectivity
    await prisma.$queryRaw`SELECT 1`;
    const responseTime = Date.now() - start;

    return {
      status: 'up',
      responseTime,
    };
  } catch (error) {
    const responseTime = Date.now() - start;
    return {
      status: 'down',
      responseTime,
      error: error instanceof Error ? error.message : 'Unknown database error',
    };
  }
  {{else}}
  return {
    status: 'up',
    responseTime: 0,
  };
  {{/if}}
}

async function checkRedis(): Promise<{
  status: 'up' | 'down';
  responseTime?: number;
  error?: string;
}> {
  {{#if features.redis}}
  const start = Date.now();
  try {
    // Simple ping to check Redis connectivity
    const pong = await redis.ping();
    const responseTime = Date.now() - start;

    if (pong === 'PONG') {
      return {
        status: 'up',
        responseTime,
      };
    } else {
      return {
        status: 'down',
        responseTime,
        error: 'Redis did not respond with PONG',
      };
    }
  } catch (error) {
    const responseTime = Date.now() - start;
    return {
      status: 'down',
      responseTime,
      error: error instanceof Error ? error.message : 'Unknown Redis error',
    };
  }
  {{else}}
  return {
    status: 'up',
    responseTime: 0,
  };
  {{/if}}
}

async function performHealthCheck(): Promise<HealthCheck> {
  const startTime = Date.now();

  // Check all services in parallel
  const [databaseHealth{{#if features.redis}}, redisHealth{{/if}}] = await Promise.all([
    checkDatabase(),
    {{#if features.redis}}
    checkRedis(),
    {{/if}}
  ]);

  // Determine overall health status
  let status: 'healthy' | 'degraded' | 'unhealthy' = 'healthy';

  const services: HealthCheck['services'] = {
    database: databaseHealth,
    {{#if features.redis}}
    redis: redisHealth,
    {{/if}}
  };

  // Check if any service is down
  const servicesDown = Object.values(services).filter(
    (service) => service?.status === 'down'
  ).length;

  if (servicesDown > 0) {
    // If critical services are down, mark as unhealthy
    if (databaseHealth.status === 'down') {
      status = 'unhealthy';
    } else {
      status = 'degraded';
    }
  }

  // Check response times
  const slowServices = Object.values(services).filter(
    (service) => service?.responseTime && service.responseTime > 1000
  ).length;

  if (slowServices > 0 && status === 'healthy') {
    status = 'degraded';
  }

  return {
    status,
    timestamp: new Date().toISOString(),
    uptime: process.uptime(),
    services,
    environment: process.env.NODE_ENV || 'development',
    version: process.env.APP_VERSION || '1.0.0',
  };
}

export async function GET(request: Request) {
  try {
    const now = Date.now();

    // Return cached result if still valid
    if (cachedHealth && now - cacheTimestamp < CACHE_TTL) {
      const statusCode = cachedHealth.status === 'healthy' ? 200 : cachedHealth.status === 'degraded' ? 200 : 503;

      return NextResponse.json(cachedHealth, {
        status: statusCode,
        headers: {
          'Cache-Control': 'private, no-cache, no-store, must-revalidate',
          'Content-Type': 'application/json',
        },
      });
    }

    // Perform health check
    const health = await performHealthCheck();

    // Update cache
    cachedHealth = health;
    cacheTimestamp = now;

    // Return appropriate status code based on health
    const statusCode = health.status === 'healthy' ? 200 : health.status === 'degraded' ? 200 : 503;

    return NextResponse.json(health, {
      status: statusCode,
      headers: {
        'Cache-Control': 'private, no-cache, no-store, must-revalidate',
        'Content-Type': 'application/json',
      },
    });
  } catch (error) {
    console.error('Health check error:', error);

    const errorResponse: HealthCheck = {
      status: 'unhealthy',
      timestamp: new Date().toISOString(),
      uptime: process.uptime(),
      services: {
        database: {
          status: 'down',
          error: 'Health check failed',
        },
      },
      environment: process.env.NODE_ENV || 'development',
      version: process.env.APP_VERSION || '1.0.0',
    };

    return NextResponse.json(errorResponse, {
      status: 503,
      headers: {
        'Cache-Control': 'private, no-cache, no-store, must-revalidate',
        'Content-Type': 'application/json',
      },
    });
  }
}

// HEAD request for simple alive check
export async function HEAD() {
  return new NextResponse(null, { status: 200 });
}
