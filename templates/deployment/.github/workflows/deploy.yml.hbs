name: CI/CD Pipeline

on:
  pull_request:
    branches: [develop, main]
  push:
    branches: [develop, main]

env:
  NODE_VERSION: '20.x'
  PNPM_VERSION: '8'

jobs:
  test:
    name: Test & Lint
    runs-on: ubuntu-latest

    services:
      postgres:
        image: postgres:15
        env:
          POSTGRES_USER: test
          POSTGRES_PASSWORD: test
          POSTGRES_DB: test_db
        options: >-
          --health-cmd pg_isready
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
        ports:
          - 5432:5432
      {{#if features.redis}}
      redis:
        image: redis:7-alpine
        options: >-
          --health-cmd "redis-cli ping"
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
        ports:
          - 6379:6379
      {{/if}}

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Setup pnpm
        uses: pnpm/action-setup@v2
        with:
          version: {{{{raw}}}}'${{{{ env.PNPM_VERSION }}}}'{{{{/raw}}}}

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: {{{{raw}}}}'${{{{ env.NODE_VERSION }}}}'{{{{/raw}}}}
          cache: 'pnpm'

      - name: Install dependencies
        run: pnpm install --frozen-lockfile

      - name: Run ESLint
        run: pnpm lint

      - name: Run type check
        run: pnpm type-check

      - name: Run Prettier
        run: pnpm format:check

      - name: Setup test database
        env:
          DATABASE_URL: postgresql://test:test@localhost:5432/test_db
        run: |
          pnpm db:push
          pnpm db:seed

      - name: Run unit tests
        env:
          DATABASE_URL: postgresql://test:test@localhost:5432/test_db
          {{#if features.redis}}
          REDIS_URL: redis://localhost:6379
          {{/if}}
          NEXTAUTH_SECRET: test-secret-key-for-ci
          NEXTAUTH_URL: http://localhost:3000
        run: pnpm test

      - name: Run E2E tests
        env:
          DATABASE_URL: postgresql://test:test@localhost:5432/test_db
          {{#if features.redis}}
          REDIS_URL: redis://localhost:6379
          {{/if}}
          NEXTAUTH_SECRET: test-secret-key-for-ci
          NEXTAUTH_URL: http://localhost:3000
        run: pnpm test:e2e

      - name: Upload coverage reports
        uses: codecov/codecov-action@v3
        with:
          files: ./coverage/coverage-final.json
          flags: unittests
          name: codecov-umbrella

  build:
    name: Build Verification
    runs-on: ubuntu-latest
    needs: test

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Setup pnpm
        uses: pnpm/action-setup@v2
        with:
          version: {{{{raw}}}}'${{{{ env.PNPM_VERSION }}}}'{{{{/raw}}}}

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: {{{{raw}}}}'${{{{ env.NODE_VERSION }}}}'{{{{/raw}}}}
          cache: 'pnpm'

      - name: Install dependencies
        run: pnpm install --frozen-lockfile

      - name: Build application
        run: pnpm build
        env:
          SKIP_ENV_VALIDATION: true

      - name: Check build size
        run: |
          echo "Build size analysis:"
          du -sh .next/
          du -sh .next/static/

          # Warn if build is too large
          SIZE=$(du -sm .next/ | cut -f1)
          if [ $SIZE -gt 100 ]; then
            echo "::warning::Build size is ${SIZE}MB, consider optimization"
          fi

  security:
    name: Security Scan
    runs-on: ubuntu-latest
    needs: test

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Run Trivy vulnerability scanner
        uses: aquasecurity/trivy-action@master
        with:
          scan-type: 'fs'
          scan-ref: '.'
          format: 'sarif'
          output: 'trivy-results.sarif'

      - name: Upload Trivy results to GitHub Security
        uses: github/codeql-action/upload-sarif@v3
        with:
          sarif_file: 'trivy-results.sarif'

      - name: Setup pnpm
        uses: pnpm/action-setup@v2
        with:
          version: {{{{raw}}}}'${{{{ env.PNPM_VERSION }}}}'{{{{/raw}}}}

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: {{{{raw}}}}'${{{{ env.NODE_VERSION }}}}'{{{{/raw}}}}
          cache: 'pnpm'

      - name: Run npm audit
        run: pnpm audit --audit-level=moderate
        continue-on-error: true

  deploy-staging:
    name: Deploy to Staging
    runs-on: ubuntu-latest
    needs: [test, build, security]
    if: github.ref == 'refs/heads/develop' && github.event_name == 'push'
    environment:
      name: staging
      url: {{{{raw}}}}'${{{{ steps.deploy.outputs.url }}}}'{{{{/raw}}}}

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      {{#if deployment.vercel}}
      - name: Deploy to Vercel (Staging)
        id: deploy
        uses: amondnet/vercel-action@v25
        with:
          vercel-token: {{{{raw}}}}'${{{{ secrets.VERCEL_TOKEN }}}}'{{{{/raw}}}}
          vercel-org-id: {{{{raw}}}}'${{{{ secrets.VERCEL_ORG_ID }}}}'{{{{/raw}}}}
          vercel-project-id: {{{{raw}}}}'${{{{ secrets.VERCEL_PROJECT_ID }}}}'{{{{/raw}}}}
          vercel-args: '--env DATABASE_URL=${{{{ secrets.STAGING_DATABASE_URL }}}} {{#if features.redis}}--env REDIS_URL=${{{{ secrets.STAGING_REDIS_URL }}}}{{/if}}'
          scope: {{{{raw}}}}'${{{{ secrets.VERCEL_ORG_ID }}}}'{{{{/raw}}}}
      {{/if}}

      {{#if deployment.railway}}
      - name: Deploy to Railway (Staging)
        uses: bervProject/railway-deploy@main
        with:
          railway_token: {{{{raw}}}}'${{{{ secrets.RAILWAY_TOKEN }}}}'{{{{/raw}}}}
          service: {{{{raw}}}}'${{{{ secrets.RAILWAY_SERVICE }}}}'{{{{/raw}}}}
          environment: staging
      {{/if}}

      - name: Run database migrations
        run: |
          # Add migration commands here
          echo "Running migrations on staging..."

      - name: Health check
        run: |
          sleep 10
          curl -f {{{{raw}}}}'${{{{ steps.deploy.outputs.url }}}}/api/health'{{{{/raw}}}} || exit 1

      - name: Notify deployment
        uses: 8398a7/action-slack@v3
        if: always()
        with:
          status: {{{{raw}}}}'${{{{ job.status }}}}'{{{{/raw}}}}
          text: 'Staging deployment {{{{raw}}}}${{{{ job.status }}}}{{{{/raw}}}}'
          webhook_url: {{{{raw}}}}'${{{{ secrets.SLACK_WEBHOOK }}}}'{{{{/raw}}}}

  deploy-production:
    name: Deploy to Production
    runs-on: ubuntu-latest
    needs: [test, build, security]
    if: github.ref == 'refs/heads/main' && github.event_name == 'push'
    environment:
      name: production
      url: {{{{raw}}}}'${{{{ steps.deploy.outputs.url }}}}'{{{{/raw}}}}

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      {{#if deployment.vercel}}
      - name: Deploy to Vercel (Production)
        id: deploy
        uses: amondnet/vercel-action@v25
        with:
          vercel-token: {{{{raw}}}}'${{{{ secrets.VERCEL_TOKEN }}}}'{{{{/raw}}}}
          vercel-org-id: {{{{raw}}}}'${{{{ secrets.VERCEL_ORG_ID }}}}'{{{{/raw}}}}
          vercel-project-id: {{{{raw}}}}'${{{{ secrets.VERCEL_PROJECT_ID }}}}'{{{{/raw}}}}
          vercel-args: '--prod --env DATABASE_URL=${{{{ secrets.PRODUCTION_DATABASE_URL }}}} {{#if features.redis}}--env REDIS_URL=${{{{ secrets.PRODUCTION_REDIS_URL }}}}{{/if}}'
          scope: {{{{raw}}}}'${{{{ secrets.VERCEL_ORG_ID }}}}'{{{{/raw}}}}
      {{/if}}

      {{#if deployment.railway}}
      - name: Deploy to Railway (Production)
        uses: bervProject/railway-deploy@main
        with:
          railway_token: {{{{raw}}}}'${{{{ secrets.RAILWAY_TOKEN }}}}'{{{{/raw}}}}
          service: {{{{raw}}}}'${{{{ secrets.RAILWAY_SERVICE }}}}'{{{{/raw}}}}
          environment: production
      {{/if}}

      {{#if deployment.fly}}
      - name: Deploy to Fly.io
        uses: superfly/flyctl-actions/setup-flyctl@master
      - run: flyctl deploy --remote-only
        env:
          FLY_API_TOKEN: {{{{raw}}}}'${{{{ secrets.FLY_API_TOKEN }}}}'{{{{/raw}}}}
      {{/if}}

      - name: Run database migrations
        run: |
          # Add migration commands here
          echo "Running migrations on production..."

      - name: Health check
        run: |
          sleep 15
          for i in {1..5}; do
            if curl -f {{{{raw}}}}'${{{{ steps.deploy.outputs.url }}}}/api/health'{{{{/raw}}}}; then
              echo "Health check passed"
              exit 0
            fi
            echo "Attempt $i failed, retrying..."
            sleep 10
          done
          exit 1

      - name: Create Sentry release
        uses: getsentry/action-release@v1
        env:
          SENTRY_AUTH_TOKEN: {{{{raw}}}}'${{{{ secrets.SENTRY_AUTH_TOKEN }}}}'{{{{/raw}}}}
          SENTRY_ORG: {{{{raw}}}}'${{{{ secrets.SENTRY_ORG }}}}'{{{{/raw}}}}
          SENTRY_PROJECT: {{{{raw}}}}'${{{{ secrets.SENTRY_PROJECT }}}}'{{{{/raw}}}}
        with:
          environment: production
          version: {{{{raw}}}}'${{{{ github.sha }}}}'{{{{/raw}}}}

      - name: Notify deployment
        uses: 8398a7/action-slack@v3
        if: always()
        with:
          status: {{{{raw}}}}'${{{{ job.status }}}}'{{{{/raw}}}}
          text: 'Production deployment {{{{raw}}}}${{{{ job.status }}}}{{{{/raw}}}}'
          webhook_url: {{{{raw}}}}'${{{{ secrets.SLACK_WEBHOOK }}}}'{{{{/raw}}}}
