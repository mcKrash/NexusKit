#!/bin/bash

# Deployment script for {{projectName}}
# This script helps deploy your application to various platforms

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Functions
print_success() {
    echo -e "${GREEN}✓${NC} $1"
}

print_error() {
    echo -e "${RED}✗${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}!${NC} $1"
}

print_info() {
    echo -e "${YELLOW}→${NC} $1"
}

# Check if command exists
command_exists() {
    command -v "$1" >/dev/null 2>&1
}

# Pre-deployment checks
pre_deployment_checks() {
    print_info "Running pre-deployment checks..."

    # Check Node version
    NODE_VERSION=$(node -v | cut -d'v' -f2 | cut -d'.' -f1)
    if [ "$NODE_VERSION" -lt 18 ]; then
        print_error "Node.js version must be 18 or higher. Current: $(node -v)"
        exit 1
    fi
    print_success "Node.js version: $(node -v)"

    # Check if .env.production exists
    if [ ! -f .env.production ]; then
        print_warning ".env.production not found. Using environment variables."
    else
        print_success ".env.production found"
    fi

    # Run tests
    print_info "Running tests..."
    if pnpm test; then
        print_success "Tests passed"
    else
        print_error "Tests failed. Aborting deployment."
        exit 1
    fi

    # Run type check
    print_info "Running type check..."
    if pnpm type-check; then
        print_success "Type check passed"
    else
        print_error "Type check failed. Aborting deployment."
        exit 1
    fi

    # Run linter
    print_info "Running linter..."
    if pnpm lint; then
        print_success "Linting passed"
    else
        print_error "Linting failed. Aborting deployment."
        exit 1
    fi

    # Build verification
    print_info "Verifying build..."
    if pnpm build; then
        print_success "Build successful"
    else
        print_error "Build failed. Aborting deployment."
        exit 1
    fi
}

# Deploy to Vercel
deploy_vercel() {
    print_info "Deploying to Vercel..."

    if ! command_exists vercel; then
        print_error "Vercel CLI not found. Install with: npm i -g vercel"
        exit 1
    fi

    if [ "$1" = "production" ]; then
        vercel --prod
    else
        vercel
    fi

    print_success "Deployed to Vercel"
}

# Deploy to Railway
deploy_railway() {
    print_info "Deploying to Railway..."

    if ! command_exists railway; then
        print_error "Railway CLI not found. Install with: npm i -g @railway/cli"
        exit 1
    fi

    railway up

    print_success "Deployed to Railway"
}

# Deploy to Fly.io
deploy_fly() {
    print_info "Deploying to Fly.io..."

    if ! command_exists flyctl; then
        print_error "Fly CLI not found. Install from: https://fly.io/docs/hands-on/install-flyctl/"
        exit 1
    fi

    flyctl deploy

    print_success "Deployed to Fly.io"
}

# Deploy with Docker
deploy_docker() {
    print_info "Deploying with Docker..."

    if ! command_exists docker; then
        print_error "Docker not found. Install from: https://docs.docker.com/get-docker/"
        exit 1
    fi

    # Build image
    print_info "Building Docker image..."
    docker build -t {{projectName}}:latest -f docker/Dockerfile .

    # Run with docker-compose
    print_info "Starting services..."
    docker-compose -f docker/docker-compose.yml up -d

    print_success "Deployed with Docker"
}

# Deploy to Kubernetes
deploy_kubernetes() {
    print_info "Deploying to Kubernetes..."

    if ! command_exists kubectl; then
        print_error "kubectl not found. Install from: https://kubernetes.io/docs/tasks/tools/"
        exit 1
    fi

    # Apply configurations
    print_info "Applying Kubernetes configurations..."
    kubectl apply -f k8s/ -n {{projectName}}

    # Wait for rollout
    print_info "Waiting for rollout to complete..."
    kubectl rollout status deployment/{{projectName}} -n {{projectName}}

    print_success "Deployed to Kubernetes"
}

# Health check
health_check() {
    local url=$1
    local max_attempts=10
    local attempt=1

    print_info "Performing health check..."

    while [ $attempt -le $max_attempts ]; do
        if curl -f -s "$url/api/health" >/dev/null 2>&1; then
            print_success "Health check passed"
            return 0
        fi

        print_warning "Health check attempt $attempt/$max_attempts failed. Retrying..."
        sleep 5
        attempt=$((attempt + 1))
    done

    print_error "Health check failed after $max_attempts attempts"
    return 1
}

# Main deployment flow
main() {
    echo ""
    echo "╔════════════════════════════════════════╗"
    echo "║  {{projectName}} Deployment Script    ║"
    echo "╚════════════════════════════════════════╝"
    echo ""

    # Parse arguments
    PLATFORM=${1:-""}
    ENVIRONMENT=${2:-"staging"}

    if [ -z "$PLATFORM" ]; then
        echo "Usage: $0 <platform> [environment]"
        echo ""
        echo "Platforms:"
        echo "  vercel      - Deploy to Vercel"
        echo "  railway     - Deploy to Railway"
        echo "  fly         - Deploy to Fly.io"
        echo "  docker      - Deploy with Docker"
        echo "  kubernetes  - Deploy to Kubernetes"
        echo ""
        echo "Environment (optional):"
        echo "  staging     - Deploy to staging (default)"
        echo "  production  - Deploy to production"
        echo ""
        exit 1
    fi

    # Confirm production deployment
    if [ "$ENVIRONMENT" = "production" ]; then
        print_warning "You are about to deploy to PRODUCTION!"
        read -p "Are you sure? (yes/no): " -r
        echo
        if [[ ! $REPLY =~ ^[Yy][Ee][Ss]$ ]]; then
            print_info "Deployment cancelled"
            exit 0
        fi
    fi

    # Run pre-deployment checks
    pre_deployment_checks

    # Deploy based on platform
    case $PLATFORM in
        vercel)
            deploy_vercel "$ENVIRONMENT"
            ;;
        railway)
            deploy_railway
            ;;
        fly)
            deploy_fly
            ;;
        docker)
            deploy_docker
            ;;
        kubernetes|k8s)
            deploy_kubernetes
            ;;
        *)
            print_error "Unknown platform: $PLATFORM"
            exit 1
            ;;
    esac

    echo ""
    print_success "Deployment complete!"
    echo ""

    # Optional: Run health check if URL provided
    if [ -n "$HEALTH_CHECK_URL" ]; then
        health_check "$HEALTH_CHECK_URL"
    fi
}

# Run main function
main "$@"
