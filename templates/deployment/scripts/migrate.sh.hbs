#!/bin/bash

# Database migration script for {{projectName}}
# Run this after deploying to apply database changes

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

print_success() {
    echo -e "${GREEN}✓${NC} $1"
}

print_error() {
    echo -e "${RED}✗${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}!${NC} $1"
}

print_info() {
    echo -e "${YELLOW}→${NC} $1"
}

echo ""
echo "╔═══════════════════════════════════════════╗"
echo "║  {{projectName}} Database Migration      ║"
echo "╚═══════════════════════════════════════════╝"
echo ""

# Check if DATABASE_URL is set
if [ -z "$DATABASE_URL" ]; then
    print_error "DATABASE_URL is not set!"
    echo ""
    echo "Set it with:"
    echo "  export DATABASE_URL='postgresql://user:password@host:5432/database'"
    echo ""
    exit 1
fi

print_success "DATABASE_URL is set"

# Confirm production migration
if [[ "$DATABASE_URL" == *"production"* ]] || [[ "$DATABASE_URL" == *"prod"* ]]; then
    print_warning "This appears to be a PRODUCTION database!"
    read -p "Are you sure you want to migrate? (yes/no): " -r
    echo
    if [[ ! $REPLY =~ ^[Yy][Ee][Ss]$ ]]; then
        print_info "Migration cancelled"
        exit 0
    fi
fi

{{#if database.prisma}}
# Backup database (if possible)
print_info "Creating database backup..."
BACKUP_FILE="backup_$(date +%Y%m%d_%H%M%S).sql"

if command -v pg_dump >/dev/null 2>&1; then
    if pg_dump "$DATABASE_URL" > "$BACKUP_FILE" 2>/dev/null; then
        print_success "Backup created: $BACKUP_FILE"
    else
        print_warning "Could not create backup (continuing anyway)"
    fi
else
    print_warning "pg_dump not found, skipping backup"
fi

# Run Prisma migrations
print_info "Running Prisma migrations..."

if pnpm prisma migrate deploy; then
    print_success "Migrations applied successfully"
else
    print_error "Migration failed!"

    if [ -f "$BACKUP_FILE" ]; then
        print_info "Backup available at: $BACKUP_FILE"
        echo ""
        echo "To restore:"
        echo "  psql \$DATABASE_URL < $BACKUP_FILE"
    fi

    exit 1
fi

# Generate Prisma client
print_info "Generating Prisma client..."
if pnpm prisma generate; then
    print_success "Prisma client generated"
else
    print_error "Failed to generate Prisma client"
    exit 1
fi

# Optional: Seed database
if [ "$1" = "--seed" ]; then
    print_info "Seeding database..."
    if pnpm prisma db seed; then
        print_success "Database seeded"
    else
        print_warning "Seeding failed (continuing anyway)"
    fi
fi

# Verify migration
print_info "Verifying database schema..."
if pnpm prisma migrate status; then
    print_success "Database schema is up to date"
else
    print_warning "Database schema verification failed"
fi

{{else}}
print_info "No migrations configured"
{{/if}}

echo ""
print_success "Migration complete!"
echo ""

# Show migration status
echo "Database status:"
{{#if database.prisma}}
pnpm prisma migrate status 2>/dev/null || echo "Could not fetch status"
{{/if}}
echo ""

# Cleanup old backups (keep last 5)
if [ -f "$BACKUP_FILE" ]; then
    print_info "Cleaning up old backups..."
    ls -t backup_*.sql 2>/dev/null | tail -n +6 | xargs rm -f 2>/dev/null || true
    print_success "Cleanup complete"
fi
